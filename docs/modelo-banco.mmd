erDiagram
    T_REUNIA_USUARIO ||--o{ T_REUNIA_REUNIAO : "responsavel"
    T_REUNIA_CLIENTE ||--o{ T_REUNIA_REUNIAO : "participa"
    T_REUNIA_REUNIAO ||--o| T_REUNIA_TRANSCRICAO : "possui"
    T_REUNIA_REUNIAO ||--o| T_REUNIA_ANALISE : "gera"
    T_REUNIA_USUARIO {
        NUMBER id_usuario PK
        VARCHAR2 nm_usuario "NN"
        VARCHAR2 ds_email UK "NN"
        VARCHAR2 ds_senha "NN"
        VARCHAR2 ds_cargo
        VARCHAR2 nm_empresa
        TIMESTAMP dt_cadastro "NN"
    }
    T_REUNIA_CLIENTE {
        NUMBER id_cliente PK
        VARCHAR2 nm_cliente "NN"
        CHAR nr_cnpj UK "NN"
        VARCHAR2 ds_segmento "NN"
        VARCHAR2 ds_porte "NN PEQUENO/MEDIO/GRANDE"
        VARCHAR2 ds_email_contato
        TIMESTAMP dt_cadastro "NN"
    }
    T_REUNIA_REUNIAO {
        NUMBER id_reuniao PK
        NUMBER id_usuario FK "NN"
        NUMBER id_cliente FK "NN UK com dt_reuniao"
        VARCHAR2 ds_titulo "NN"
        TIMESTAMP dt_reuniao "NN"
        NUMBER nr_duracao_min "NN"
        VARCHAR2 tp_reuniao "NN VENDAS/CS"
        VARCHAR2 st_reuniao "NN"
        CHAR fl_processada "NN S/N"
        NUMBER vl_oportunidade "VENDAS"
        NUMBER nr_score_risco "VENDAS"
        CHAR fl_concorrente "VENDAS"
        NUMBER nr_nps "CS"
        NUMBER nr_reclamacoes "CS"
        CHAR fl_sinal_churn "CS"
    }
    T_REUNIA_TRANSCRICAO {
        NUMBER id_transcricao PK
        NUMBER id_reuniao FK "NN UK"
        CLOB ds_texto "NN"
        NUMBER nr_palavras "NN"
        TIMESTAMP dt_envio "NN"
    }
    T_REUNIA_ANALISE {
        NUMBER id_analise PK
        NUMBER id_reuniao FK "NN UK"
        VARCHAR2 ds_sentimento "NN"
        NUMBER nr_score_sentimento "NN"
        NUMBER nr_risco_churn "NN"
        NUMBER nr_score_oportunidade "NN"
        VARCHAR2 ds_produtos
        VARCHAR2 ds_concorrentes
        VARCHAR2 ds_termos
        VARCHAR2 ds_recomendacao "NN"
        TIMESTAMP dt_analise "NN"
    }
