        +excluir(Long) void
        +listarPrioritarias() List~Reuniao~
        +enviarTranscricao(Long, String) Analise
    }
    class AnaliseService {
        +analisar(String) Analise
    }
    class ClienteService {
        +cadastrar(ClienteDTO) Cliente
        +atualizar(Long, ClienteDTO) Cliente
