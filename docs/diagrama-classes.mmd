    class UsuarioService {
        +cadastrar(UsuarioDTO) Usuario
        +atualizar(Long, UsuarioDTO) Usuario
        +excluir(Long) void
        +login(LoginDTO) Usuario
    }
    class ReuniaoRepository {
        <<interface>>
        +findByCodigo(Long) Reuniao
        +findByCodigoCliente(Long) List~Reuniao~
        +findByTipo(String) List~Reuniao~
        +findByStatus(String) List~Reuniao~
    }
    class ReuniaoController {
        +cadastrar(ReuniaoDTO) ResponseEntity
        +consultar() ResponseEntity
        +consultarPorCodigo(Long) ResponseEntity
        +atualizar(Long, ReuniaoDTO) ResponseEntity
        +excluir(Long) ResponseEntity
        +enviarTranscricao(Long, TranscricaoDTO) ResponseEntity
    }
    Usuario "1" <-- "0..*" Reuniao : codigoUsuario
    Cliente "1" <-- "0..*" Reuniao : codigoCliente
    Reuniao "1" <-- "0..1" Transcricao : codigoReuniao
    Reuniao "1" <-- "0..1" Analise : codigoReuniao
    ReuniaoController --> ReuniaoService
    ReuniaoController --> ReuniaoRepository
    ReuniaoService --> AnaliseService
    ReuniaoService --> ReuniaoRepository
    ReuniaoRepository ..> Reuniao
