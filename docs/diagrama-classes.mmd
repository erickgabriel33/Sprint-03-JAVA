classDiagram
    direction TB
    class Usuario {
        -Long codigo
        -String nome
        -String email
        -String senha
        -String cargo
        -String empresa
        +Usuario(UsuarioDTO)
    }
    class Cliente {
        -Long codigo
        -String nome
        -String cnpj
        -String segmento
        -String porte
        -String email
        +Cliente(ClienteDTO)
    }
    class Reuniao {
